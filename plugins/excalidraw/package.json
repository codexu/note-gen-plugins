{
  "name": "@notegen/plugin-excalidraw",
  "version": "0.1.0",
  "private": true,
  "description": "Preview Excalidraw JSON scenes as static offline diagrams.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "esbuild ../../tools/build-code-block-renderer.ts --bundle --platform=node --format=esm --packages=external --outfile=.notegen/build-renderer.mjs && node .notegen/build-renderer.mjs && notegen-plugin build",
    "validate": "notegen-plugin validate",
    "plugin:pack": "notegen-plugin pack"
  },
  "notegen": {
    "source": "src/renderer.ts"
  },
  "dependencies": {
    "@excalidraw/utils": "0.1.5"
  },
  "devDependencies": {
    "@notegen/plugin-api": "workspace:^",
    "@notegen/plugin-cli": "workspace:^",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=20"
  }
}
