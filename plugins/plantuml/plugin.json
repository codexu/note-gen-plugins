{
  "manifestVersion": 1,
  "id": "top.notegen.plantuml",
  "name": "%name%",
  "description": "%description%",
  "version": "0.1.0",
  "apiVersion": ">=0.1.6",
  "minAppVersion": "0.38.3",
  "platforms": ["desktop"],
  "activationEvents": [],
