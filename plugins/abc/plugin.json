{
  "manifestVersion": 1,
  "id": "top.notegen.abc",
  "name": "%name%",
  "description": "%description%",
  "version": "0.1.0",
  "apiVersion": ">=0.1.9",
  "minAppVersion": "0.38.3",
  "platforms": [
    "desktop"
  ],
  "activationEvents": [],
  "permissions": {},
  "contributes": {},
  "resources": {
    "codeBlockRenderers": [
      {
        "id": "abc",
        "name": "%renderer.name%",
        "languages": [
          "abc"
        ],
        "script": "dist/renderer.js",
