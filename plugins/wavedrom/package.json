{
  "name": "@notegen/plugin-wavedrom",
  "version": "0.1.0",
  "private": true,
  "description": "Preview WaveDrom digital timing diagrams offline.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "esbuild ../../tools/build-code-block-renderer.ts --bundle --platform=node --format=esm --packages=external --outfile=.notegen/build-renderer.mjs && node .notegen/build-renderer.mjs && notegen-plugin build",
    "validate": "notegen-plugin validate",
    "plugin:pack": "notegen-plugin pack"
  },
  "notegen": {
    "source": "src/renderer.ts"
  },
  "dependencies": {
    "wavedrom": "3.7.0",
    "json5": "2.2.3",
    "onml": "2.1.0"
  },
  "devDependencies": {
    "@notegen/plugin-api": "workspace:^0.1.12",
    "@notegen/plugin-cli": "workspace:^0.1.12",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=20"
  }
}
