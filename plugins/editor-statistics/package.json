{
  "name": "@notegen/plugin-editor-statistics",
  "version": "0.1.0",
  "private": true,
  "description": "Official Editor Statistics plugin for NoteGen.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && notegen-plugin build",
    "validate": "tsc -p tsconfig.json --noEmit && notegen-plugin validate",
    "plugin:pack": "notegen-plugin pack"
  },
  "notegen": {
    "source": "src/main.ts"
  },
  "dependencies": {
    "graphemer": "^1.4.0",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@notegen/plugin-api": "workspace:^",
    "@notegen/plugin-cli": "workspace:^",
    "@types/markdown-it": "^14.1.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
