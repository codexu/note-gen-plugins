{
  "name": "@notegen/plugin-daily-notes",
  "version": "0.1.1",
  "private": true,
  "description": "Official Daily Notes plugin for NoteGen.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && notegen-plugin build",
