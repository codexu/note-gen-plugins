{
  "name": "@notegen/plugin-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Official interactive terminal plugin for NoteGen.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "bundle:terminal": "esbuild src/terminal-frame.ts --bundle --format=iife --platform=browser --target=es2022 --minify --outdir=dist",
    "dev": "node ../../tools/dev-terminal.mjs",
    "build": "tsc -p tsconfig.json --noEmit && pnpm run bundle:terminal && notegen-plugin build",
    "validate": "tsc -p tsconfig.json --noEmit && pnpm run bundle:terminal && notegen-plugin validate",
    "plugin:pack": "pnpm run bundle:terminal && notegen-plugin pack"
  },
  "notegen": { "source": "src/main.ts" },
  "devDependencies": {
    "@notegen/plugin-api": "workspace:^",
    "@notegen/plugin-cli": "workspace:^",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "engines": { "node": ">=20" }
}
